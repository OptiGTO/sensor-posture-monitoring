{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sensor-posture-monitoring.local/schemas/model_artifact_v2.schema.json",
  "title": "Immutable posture model artifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_id", "display_name", "version", "backend",
    "model_family", "artifact_file", "artifact_sha256", "labels",
    "input_channels", "sampling_rate", "window", "preprocessing",
    "output_type", "confidence_semantics", "calibration_status", "created_at",
    "provenance", "runtime", "sensors", "validation", "metadata"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "backend": {"enum": ["sklearn", "pytorch"]},
    "model_family": {"type": "string", "minLength": 1},
    "artifact_file": {"type": "string", "minLength": 1},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "file", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "required": {"type": "boolean", "default": true}
        }
      }
    },
    "labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sampling_rate": {"type": "number", "exclusiveMinimum": 0},
    "window": {"$ref": "#/$defs/window"},
    "preprocessing": {"type": "object"},
    "output_type": {"enum": ["probabilities", "logits"]},
    "confidence_semantics": {"type": "string", "minLength": 1},
    "calibration_status": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "created_by"],
      "properties": {
        "source": {"enum": ["training_run", "imported", "built_in_baseline"]},
        "created_by": {"type": "string", "minLength": 1},
        "training_run": {"type": "string"},
        "dataset_fingerprint": {"type": "string"},
        "code_revision": {"type": "string"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "packages"],
      "properties": {
        "python": {"type": "string", "pattern": "^(>=|<=|==|>|<)[0-9]+(\\.[0-9]+)*$"},
        "packages": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "sensors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "supported_devices"],
      "properties": {
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supported_devices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cpu", "mps", "cuda"]}}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation", "semantic_mapping", "device_tolerances"],
      "properties": {
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["split_strategy", "integrity_status"],
          "properties": {
            "split_strategy": {"type": "string", "minLength": 1},
            "integrity_status": {"enum": ["pending", "passed", "failed"]},
            "evidence_files": {"type": "array", "items": {"type": "string"}}
          }
        },
        "semantic_mapping": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "device_tolerances": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "golden_replays": {"type": "array", "minItems": 1, "items": {"$ref": "#/properties/validation/properties/golden_replay"}},
        "golden_replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_file", "expected_label"],
          "properties": {
            "input_file": {"type": "string", "minLength": 1},
            "expected_label": {"type": "string", "minLength": 1},
            "label_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "expected_scores": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
            "window_count": {"type": "integer", "minimum": 1},
            "window_seconds": {"type": "number", "exclusiveMinimum": 0},
            "expected_confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "probability_atol": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"window": {"properties": {"policy": {"const": "fixed"}}}}},
      "then": {"properties": {"window": {"required": ["values_seconds"], "properties": {"values_seconds": {"minItems": 1, "maxItems": 1}}}}}
    },
    {
      "if": {"properties": {"window": {"properties": {"policy": {"const": "discrete"}}}}},
      "then": {"properties": {"window": {"required": ["values_seconds"]}}}
    },
    {
      "if": {"properties": {"window": {"properties": {"policy": {"const": "range"}}}}},
      "then": {"properties": {"window": {"required": ["minimum_seconds", "maximum_seconds", "step_seconds"]}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "target_sample_rule", "padding_policy"],
      "properties": {
        "policy": {"enum": ["fixed", "discrete", "range"]},
        "values_seconds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "exclusiveMinimum": 0}},
        "minimum_seconds": {"type": "number", "exclusiveMinimum": 0},
        "maximum_seconds": {"type": "number", "exclusiveMinimum": 0},
        "step_seconds": {"type": "number", "exclusiveMinimum": 0},
        "target_sample_rule": {"const": "round(window_seconds * sampling_rate)"},
        "padding_policy": {"enum": ["reject", "interpolate_time_axis"]}
      }
    }
  }
}
